# Environment Variables Example for RWA Lens
# Copy to .env and populate with local configuration

# Network / RPC Configuration
BNB_CHAIN_RPC_URL=
BNB_CHAIN_ID=56

# App Configuration
PORT=3000
NODE_ENV=development

# Server-only Binance Web3 authentication
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET_KEY=
